[advice]
	skippedCherryPicks = false
[alias]
	# Accepts an unquoted commit message if provided, otherwise opens editor
	c = "!_f(){ [ $# -gt 0 ] && git commit -m \"$*\" || git commit -v; };_f"
	# extend the prior commit with currently-staged changes
	ce = commit --amend --reuse-message=HEAD
	co = checkout
	d = diff
	dc = diff --cached
	p = add -p
	l = log --oneline
	# your most recently checked out refs, deduped
	latest = "!git reflog | grep checkout: | awk '{print $6}' | awk '!H[$0]++'"
	# a safer force push
	shove = push --force-with-lease
[branch]
	sort = -committerdate
[column]
	ui = auto
[commit]
	verbose = true
[core]
	excludesfile = ~/.gitignore
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[feature]
	experimental = true
[fetch]
	prune = true
	pruneTage = true
	all = true
[github]
	user = ambirdsall
[grep]
	patternType = perl
[help]
	autocorrect = prompt
[include]
	path = "~/.gitconfig.local"
[init]
	defaultBranch = main
[merge]
	conflictstyle = zdiff3
[pull]
	rebase = true
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[rebase]
	autoSquash = true
	autoStash = true
	# updateRefs = true
[rerere]
	enabled = true
	autoupdate = true
[safe]
	directory = /home/amb/c/janet/build/spork
[tag]
	sort = version:refname
[user]
	name = Alex Birdsall
	email = ambirdsall@gmail.com
